# Copy this file to .env and fill in local-only secrets.
# Do not commit .env.

API_PORT=5175
FRONTEND_ORIGIN=http://127.0.0.1:5174

# ChatAnywhere / OpenAI-compatible API
CHATANYWHERE_BASE_URL=https://api.chatanywhere.tech/v1
CHATANYWHERE_API_KEY=replace_with_your_api_key
AI_MODEL=gpt-5-mini

# Optional: only needed if you do not use a downloaded client_secret_*.json file.
# GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
# GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
# GOOGLE_REDIRECT_URI=http://127.0.0.1:5175/api/auth/google/callback
